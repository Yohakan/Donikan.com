# --- ZORUNLU ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL bağlantı adresi (Neon / Vercel Postgres / Supabase)
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# --- İSTEĞE BAĞLI ---
# Görsel kaynakları (ikisi de boşsa SVG/gradient yedek görsel kullanılır)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Gemini istek zaman aşımı (ms) ve en fazla çıktı token'ı
GEMINI_TIMEOUT_MS=240000
GEMINI_MAX_OUTPUT_TOKENS=60000
